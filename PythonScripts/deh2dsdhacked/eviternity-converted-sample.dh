thing 381 "_Golden Astral Caco Boss"
{
	health 1200
	speed 16
	radius 31
	height 56
	reactiontime 8
	painchance 20
	mass 1000
	seesound "fre005"
	painsound "fre007"
	deathsound "fre008"

	clear flags
	+SOLID
	+SHOOTABLE
	+NOGRAVITY
	+FLOAT
	+COUNTKILL

	states
	{
	spawn:
		SP09 A 10 Bright A_Look
		loop
	see:
		SP09 A 3 Bright A_Chase
		loop
	missile:
		SP09 E 1 Bright A_FaceTarget
		SP09 E 1 Bright A_PlaySound("fre006")
		SP09 EEEEEEE 1 Bright A_Chase
		SP09 F 5 Bright A_FaceTarget
		SP09 G 0 Bright A_MonsterProjectile(10)	// thing 10 = MT_FATSHOT
		SP09 G 0 Bright A_MonsterProjectile(10, 17.0)	// thing 10 = MT_FATSHOT
		SP09 G 0 Bright A_MonsterProjectile(10)	// thing 10 = MT_FATSHOT
		SP09 G 3 Bright A_MonsterProjectile(10, -17.0)	// thing 10 = MT_FATSHOT
		goto see
	pain:
		SP09 H 3 Bright
		SP09 I 3 Bright A_Pain
		goto see
	death:
		SP09 J 4 Bright
		SP09 J 4 Bright A_SpawnObject(51, 0.0, 0.0, 0.0, 32.0, 0.0, 0.0, 8.0)	// thing 51 = MT_MISC7
		SP09 K 8 Bright A_Scream
		SP09 LMNOP 8 Bright
		SP09 Q 8 Bright A_Fall
