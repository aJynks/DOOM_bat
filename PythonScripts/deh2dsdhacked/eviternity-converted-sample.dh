thing 464 "_Necromenace C"
{
	health 2800
	speed 16
	radius 40
	height 96
	reactiontime 8
	painchance 10
	mass 1000
	seesound "fre048"
	painsound "fre050"
	deathsound "fre051"
	activesound "fre049"

	clear flags
	+SOLID
	+SHOOTABLE
	+COUNTKILL
	+DMGIGNORED
	+NORADIUSDMG
	+HIGHERMPROB
	+FULLVOLSOUNDS

	states
	{
	spawn:
		SP21 AB 10 A_Look
		loop
	see:
		SP21 AABBCCDD 2 A_Chase
		loop
	missile:
		SP21 E 8 Bright A_FaceTarget
		SP21 F 8 Bright A_MonsterProjectile(193)	// thing 193 = _Necromenace Fireball
		SP21 E 8 Bright A_FaceTarget
		SP21 F 8 Bright A_MonsterProjectile(193)	// thing 193 = _Necromenace Fireball
		SP21 E 8 Bright A_FaceTarget
		SP21 F 4 Bright A_MonsterProjectile(193)	// thing 193 = _Necromenace Fireball
		SP21 FF 0 Bright A_Spawn(191)	// thing 191 = _Necromenace Minion A
		SP21 FF 0 Bright A_Spawn(192)	// thing 192 = _Necromenace Minion B
		SP21 F 12 Bright A_FaceTarget
		goto see
	pain:
		SP21 G 3
		SP21 G 3 A_Pain
		goto see
	death:
		SP21 H 5
		SP21 I 5 A_Scream
		SP21 IIII 0 Bright A_Spawn(191)	// thing 191 = _Necromenace Minion A
		SP21 JKLMNO 5
		SP21 P 5 A_Fall
		SP21 QRSTUVWX 5
		SP21 Y 5 A_LineEffect(24707, 133)
		SP21 Z -1
		stop
	}
}

