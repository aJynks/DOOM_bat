weapon 1 "_Evit2 Pistol"
{
	ammopershot 1

	states
	{
	ready:
		PISG A 1 A_WeaponReady
		loop
	deselect:
		PISG A 1 A_Lower
		loop
	select:
		PISG A 1 A_Raise
		loop
	fire:
		PISG A 1
		PISG B 0 A_GunFlash
		PISG B 0 A_WeaponSound("fre073")
		PISG B 0 A_ConsumeAmmo(1)
		PISG B 2 A_WeaponBulletAttack(0.0, 0.0, 1, 5, 3)
		PISG C 2
		PISG D 1
		PISG EF 2
		goto ready
	flash:
		PISF A 4 Bright A_Light1
		goto LightDone
	}
}

weapon 7 "Perforator"
{
	ammotype 0
	ammopershot 25

	states
	{
	ready:
		GBDT A 1 A_WeaponReady
		loop
	deselect:
		GBDT A 1 A_Lower
		loop
	select:
		GBDT A 1 A_Raise
		loop
	fire:
		GBDT A 2
		GBDT A 0 A_ConsumeAmmo(25)
		GBDT A 0 A_WeaponSound("fre068", 1)
		GBDT A 0 A_GunFlashTo(flash)
		GBDT A 0 A_WeaponProjectile(368)	// thing 368 = _Rail Shot 1
		GBDT A 0 A_WeaponBulletAttack(0.0, 0.0, 3, 141, 1)
		GBDT BC 2
		GBDT A 0 A_WeaponSound("fre068", 1)
		GBDT A 0 A_GunFlashTo(flash)
		GBDT A 0 A_WeaponProjectile(372)	// thing 372 = _Rail Shot 2
		GBDT A 0 A_WeaponBulletAttack(2.0, 0.5, 8, 40, 1)
		GBDT BC 2
		GBDT A 0 A_WeaponSound("fre068", 1)
		GBDT A 0 A_GunFlashTo(st1120)
		GBDT A 0 A_WeaponProjectile(373)	// thing 373 = _Rail Shot 3
		GBDT A 0 A_WeaponBulletAttack(4.0, 1.0, 20, 15, 1)
		GBDT B 3
		GBDT C 6
		GBDT D 40 A_CheckAmmo(deselect, 25)
		GBDT A 0 A_ReFire
		goto ready
	flash:
		GBDF A 3 Bright A_Light2
		TNT1 A 2 A_Light1
		goto LightDone
	st1120:
		GBDF A 3 Bright A_Light2
		GBDF B 6 Bright A_Light1
		goto LightDone
	}
}

thing 15 "Cacodemon"	// MT_HEAD
{

	states
	{
	spawn:
		HEAD A 10 A_Look
		loop
	see:
		HEAD A 3 A_Chase
		loop
	missile:
		HEAD BC 5 A_FaceTarget
		HEAD D 5 Bright A_HeadAttack
		goto see
	pain:
		HEAD E 3
		HEAD E 3 A_Pain
		HEAD F 6
		goto see
	death:
		HEAD G 8
		HEAD H 8 A_Scream
		HEAD IJ 8
		HEAD K 8 A_Fall
		HEAD L 8
		HEAD M -1
		stop
	raise:
		HEAD LKJIHG 8
		goto see
	}
}

